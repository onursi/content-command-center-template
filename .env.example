# Kopiere diese Datei nach .env und passe sie an. .env wird nie eingecheckt.
# Alles ist optional; ohne .env gelten die Werte aus config.json bzw. config.example.json.

# Adresse des Boards. 127.0.0.1 = nur dieser Rechner (empfohlen).
CCC_HOST=127.0.0.1
CCC_PORT=8899

# Weitere Hostnamen, unter denen das Board erreichbar sein soll (kommagetrennt),
# z. B. der Name deines privaten Tunnels: mein-pc.mein-tailnet.ts.net
# 127.0.0.1 und localhost sind immer erlaubt. Alle anderen Hosts bekommen 403.
CCC_ERLAUBTE_HOSTS=

# Geteiltes Token für POST-Anfragen (Board und MCP holen es automatisch). Nur zum Testen abschalten.
CCC_TOKEN=true

# Agent-Auslöser: startet "claude -p", sobald ein Termin fällig ist oder ein Schnitt ansteht.
# Standard aus. Erst einschalten, wenn die Aufträge in geplante-aufgaben/ zu dir passen.
CCC_AGENT_AKTIV=false

# Name oder Pfad des Claude-Code-Befehls
CCC_CLAUDE_BEFEHL=claude
